<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Atata.AspNetCore</RootNamespace>
    <Description>
C#/.NET library that adds ASP.NET Core 8.0 sessions to Atata using WebApplicationFactory.

Atata.AspNetCore.v8 on GitHub: https://github.com/atata-framework/atata-aspnetcore
Atata Framework documentation: https://atata.io/

The package targets .NET 8.0.
    </Description>
    <RepositoryUrl>https://github.com/atata-framework/atata-aspnetcore</RepositoryUrl>
    <PackageId>Atata.AspNetCore.v8</PackageId>
    <PackageTags>atata automation testing test aspnetcore aspnetcoremvc aspnetcoremvctesting</PackageTags>
    <PackageReleaseNotes></PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/atata-framework/atata-aspnetcore</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Atata" Version="4.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.30" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" Version="8.10.0" />
  </ItemGroup>

</Project>
